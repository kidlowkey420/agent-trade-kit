//@version=6
strategy("Quiver Congress & Insider Backtest", shorttitle = "Quiver BT", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2,
     pyramiding = 0, max_labels_count = 500)
// Backtests buying after Congress or insider buys are disclosed, using Quiver Quant filings
// from {{FROM}} to {{AS_OF}} ({{SUMMARY}}), generated by bots/tradingview-signals.
// Tickers: {{TICKERS}}
// Entries happen at the next bar's open after the filing date, so the test never trades on a
// filing before it was public. Use it on the daily (1D) chart. Backtest only; it places no real orders.

const string AS_OF = "{{AS_OF}}"
const string FROM = "{{FROM}}"

string entryMode = input.string("Congress buy", "Buy when", options = ["Congress buy", "Insider buy", "Any buy", "Cluster buy"], group = "Entry",
     tooltip = "Cluster buy: Congress and insiders both bought within the cluster window.")
int minFilers = input.int(1, "Minimum buyers on the filing day", minval = 1, group = "Entry")
int clusterDays = input.int(30, "Cluster window (days)", minval = 1, group = "Entry")
int holdDays = input.int(30, "Hold for (calendar days)", minval = 1, group = "Exit")
float stopPct = input.float(10.0, "Stop loss % (0 = off)", minval = 0, step = 0.5, group = "Exit")
float takePct = input.float(0.0, "Take profit % (0 = off)", minval = 0, step = 0.5, group = "Exit")
bool exitOnSell = input.bool(false, "Also exit when a sell is disclosed", group = "Exit")
bool showTable = input.bool(true, "Info panel", group = "Display")

// Records are YYYYMMDD + side (B/S) + source (C = Congress, I = insider) + number of filers, oldest first.
eventsFor(string t) =>
    string s = ""
{{CASES}}
    s

string symKey = str.replace_all(str.replace_all(str.upper(syminfo.ticker), ".", ""), "-", "")

var array<int> evDay = array.new<int>()
var array<string> evSide = array.new<string>()
var array<string> evSrc = array.new<string>()
var array<int> evCount = array.new<int>()

if barstate.isfirst
    for rec in str.split(eventsFor(symKey), ";")
        if str.length(rec) >= 11
            evDay.push(int(str.tonumber(str.substring(rec, 0, 8))))
            evSide.push(str.substring(rec, 8, 9))
            evSrc.push(str.substring(rec, 9, 10))
            evCount.push(int(str.tonumber(str.substring(rec, 10))))

// Each filing lands on the first bar whose closing date is on or after the filing date.
var int nextIdx = 0
int congressBuyers = 0
int insiderBuyers = 0
bool anySell = false
int barEnd = na(time_close) ? time : time_close
int barDay = year(barEnd, syminfo.timezone) * 10000 + month(barEnd, syminfo.timezone) * 100 + dayofmonth(barEnd, syminfo.timezone)
int barStartDay = year(time, syminfo.timezone) * 10000 + month(time, syminfo.timezone) * 100 + dayofmonth(time, syminfo.timezone)
while nextIdx < evDay.size() and evDay.get(nextIdx) <= barDay
    if bar_index > 0 or evDay.get(nextIdx) >= barStartDay
        if evSide.get(nextIdx) == "B"
            if evSrc.get(nextIdx) == "C"
                congressBuyers += evCount.get(nextIdx)
            else
                insiderBuyers += evCount.get(nextIdx)
        else
            anySell := true
    nextIdx += 1

var int lastCongressBuy = na
var int lastInsiderBuy = na
bool congressBuy = congressBuyers >= minFilers
bool insiderBuy = insiderBuyers >= minFilers
if congressBuy
    lastCongressBuy := time
if insiderBuy
    lastInsiderBuy := time
bool clusterBuy = (congressBuy or insiderBuy) and not na(lastCongressBuy) and not na(lastInsiderBuy) and math.abs(lastCongressBuy - lastInsiderBuy) <= clusterDays * 86400000

bool signal = switch entryMode
    "Congress buy" => congressBuy
    "Insider buy" => insiderBuy
    "Any buy" => congressBuy or insiderBuy
    => clusterBuy

var int entryTime = na
if signal and strategy.position_size == 0
    strategy.entry("Quiver", strategy.long)

if strategy.position_size > 0
    if na(entryTime)
        entryTime := time
    float entryPrice = strategy.position_avg_price
    float stopPrice = stopPct > 0 ? entryPrice * (1 - stopPct / 100) : na
    float limitPrice = takePct > 0 ? entryPrice * (1 + takePct / 100) : na
    if stopPct > 0 or takePct > 0
        strategy.exit("Stop/target", "Quiver", stop = stopPrice, limit = limitPrice)
    if time - entryTime >= holdDays * 86400000
        strategy.close("Quiver", comment = "Hold time")
    else if exitOnSell and anySell
        strategy.close("Quiver", comment = "Sell disclosed")
else
    entryTime := na

plotshape(signal, "Buy signal", shape.triangleup, location.belowbar, color.green, size = size.small)

var table info = table.new(position.top_right, 1, 1)
if showTable and barstate.islast
    string msg = evDay.size() > 0 ? str.tostring(evDay.size()) + " Quiver filing days for " + syminfo.ticker : "No Quiver data for " + syminfo.ticker + ". Try one of the tickers listed in the script."
    table.cell(info, 0, 0, msg + "\nFilings " + FROM + " to " + AS_OF, text_color = chart.fg_color, text_size = size.small,
         bgcolor = color.new(chart.bg_color, 20))
